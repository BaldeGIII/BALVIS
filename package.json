{
  "name": "balvis",
  "productName": "BALVIS",
  "private": true,
  "version": "0.0.0",
  "description": "BALVIS: a voice-first AI research assistant",
  "author": "Baldemar Guajardo",
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "predev": "node scripts/copy-ort.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ort.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "desktop": "npm run build && electron .",
    "start": "electron .",
    "dist": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "docx": "^9.12.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.104.0",
    "pdf-parse": "^1.1.4",
    "pdfkit": "^0.20.2",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@huggingface/transformers": "^4.3.1",
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "postcss": "^8.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.4.0",
    "react-router-dom": "^7.14.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.22.0",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "com.balvis.app",
    "productName": "BALVIS",
    "files": [
      "dist/**",
      "desktop/**",
      "backend/server.js",
      "backend/lib/**",
      "backend/package.json",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Education"
    }
  }
}
