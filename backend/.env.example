# Copy this file to backend/.env and fill in your own values. backend/.env is git-ignored: never commit real keys.
# (The desktop app can store the Kimi and ElevenLabs keys encrypted from Settings instead.)

# Chat, agent and document analysis (Moonshot / Kimi)
KIMI_API_KEY=
# KIMI_MODEL=kimi-k2.6
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# KIMI_THINKING=on            # re-enable Kimi's slow "thinking" mode (off by default)

# Signs login cookies. Required in production. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: natural spoken voice (ElevenLabs)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional: paper search sources
OPENALEX_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# IEEE_API_KEY=

# Optional
# YOUTUBE_API_KEY=
# ADMIN_EMAIL=you@example.com  # the account registered with this email gets the Admin page
# CORS_ORIGINS=https://your-site.example
# BALVIS_WORKSPACE=/path/for/agent/files   # default: ~/Documents/BALVIS
